# Compress every immediate subfolder into its own ZIP and back up each ZIP.
#
# The archive and backup directories must be outside ROOT. The complete job is
# planned before any files are written. Applying the plan is transactional, so
# a failure does not leave a partially completed archive set behind.
#
# Usage:
#   ion-win.exe examples/archive_subfolders.ion ROOT ARCHIVE_DIR BACKUP_DIR
#
# Example:
#   ion-win.exe examples/archive_subfolders.ion D:/Photos E:/Archives F:/Backup

if test $len(args) -ne 4
    echo "Usage: ion-win.exe examples/archive_subfolders.ion ROOT ARCHIVE_DIR BACKUP_DIR"
    exit 2
end

let root = @args[1]
let archive_directory = @args[2]
let backup_directory = @args[3]

if not test -e $root
    echo "archive-subfolders: root does not exist: $root"
    exit 2
end

# Keep the values typed throughout the structured pipeline. Each directory in
# roots remains separate provenance, which gives compress one archive per root.
let roots = folders --all $root
let archive_files = roots | find --all --recurse

# Planning performs drift checks and previews every archive and backup path.
let plan = archive_files | compress --per-root --plan $archive_directory --backup $backup_directory

echo "Planned archives and backup destinations:"
plan | to-json

read -p "Apply this plan? Type yes to continue: " answer

if eq $answer yes
    echo "Archive and backup operation completed:"
    plan | apply
else
    echo "Cancelled. No archives or backup copies were written."
end
