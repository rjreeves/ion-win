# Back up every file under src/ into backup/, preserving each file's
# relative path, keep a CSV manifest (path/size/hash) of what got copied,
# and also produce a zipped backup.zip archive of the same files.

let manifest = find src --recurse | stat --hash sha256

manifest | to-csv > backup_manifest.csv
manifest | copy backup
manifest | compress backup.zip

echo "Manifest:"
manifest | to-csv

for row in manifest
    row | select path | to-json
end
