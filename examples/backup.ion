# Back up every file under src/ into backup/, zip it into backup.zip,
# and write a CSV manifest (path/size/hash) of what got backed up — all
# chained from one scan in a single pipe, since compress/copy forward
# the same manifest table on to whatever follows them in the pipe.

let manifest = find src --recurse | stat --hash sha256

manifest | compress backup.zip | copy backup | to-csv > backup_manifest.csv

echo "Manifest:"
manifest | to-csv

for row in manifest
    row | select path | to-json
end
