let events = echo '[{"name":"month-end","created":"2026-01-31T09:00:00"},{"name":"dst","created":"2026-09-04T09:00:00"}]' | from-json
let converted = events | date-column created due add '1 month' Australia/Sydney | date-column due display format dd-MMM-yy

echo "rows=$len(converted)"
converted | select name created due display | to-csv

let parsed = echo '[{"raw":"2026-7-3"},{"raw":"2024-2-29"}]' | from-json | date-column raw canonical date
parsed | to-csv
