# Exercises string methods, array methods, nested methods, and scalar/array slicing.
echo CASE 02 methods and slicing
let path = /root/parent/file.name.ext
let input = one two one two
let arr = [ red green blue yellow violet ]
echo path $basename(path) $filename(path) $extension(path) $parent(path)
echo replace $replace(input one 1)
echo regex $regex_replace("bob" "^b" "B")
echo join $join(arr ",")
echo len $len(input) $len(arr)
echo slice-s=$input[..3]:$input[4..7]
echo slice-a @arr[1..=3]
echo reverse @reverse(arr)
echo split @split("person, age, some data" ", ")
echo lines @lines($unescape("firstline\nsecondline"))
