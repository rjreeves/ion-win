let day: date = 2026-7-3
let at:time = 9:05
let stamp: datetime = "2026-07-03 09:05"
let span: duration = "1 day 2 hours"

echo "date=$day"
echo "time=$at"
echo "datetime=$stamp"
echo "duration=$span"
echo "month=$extract('month' $day)"
echo "truncated=$date_trunc('day' $stamp)"
echo "added=$date_add($stamp $span)"
echo "difference=$date_diff(2026-07-05 2026-07-03)"
echo "same-instant=$date_compare(2026-07-03T10:00:00+10:00 2026-07-03T00:00:00Z)"
echo $date_format($stamp "%d/%m/%Y %H:%M")
