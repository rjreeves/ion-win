let day: date = 2026-7-3
let at:time = 9:05
let stamp: datetime = "2026-07-03 09:05"
let span: duration = "1 day 2 hours"

echo "date=$day"
echo "time=$at"
echo "datetime=$stamp"
echo "duration=$span"
echo "month=$extract('month' $day)"
echo "truncated=$date_trunc('day' $stamp)"
echo "added=$date_add($stamp $span)"
echo "difference=$date_diff(2026-07-05 2026-07-03)"
echo "same-instant=$date_compare(2026-07-03T10:00:00+10:00 2026-07-03T00:00:00Z)"
echo $date_format($stamp "%d/%m/%Y %H:%M")
echo "friendly=$date_format($stamp dd-MMM-yy)"
echo "sydney-summer=$timezone(2026-01-15T00:00:00Z Australia/Sydney)"
echo "sydney-winter=$timezone(2026-07-15T00:00:00Z Australia/Sydney)"
echo "fold-earlier=$timezone(2026-04-05T02:30:00 Australia/Sydney earlier)"
echo "fold-later=$timezone(2026-04-05T02:30:00 Australia/Sydney later)"
echo "gap-forward=$timezone(2026-10-04T02:30:00 Australia/Sydney reject shift-forward)"
echo "gap-backward=$timezone(2026-10-04T02:30:00 Australia/Sydney reject shift-backward)"
echo "month-end=$date_add(2026-01-31 '1 month')"
echo "leap-year=$date_add(2024-02-29 '1 year')"
echo "calendar-mixed=$date_add(2026-01-31T10:15:00+10:00 '1 month 2 hours')"
echo "calendar-sydney=$date_add(2026-09-04T09:00:00 '1 month' Australia/Sydney)"
echo "calendar-gap=$date_add(2026-09-04T02:30:00 '1 month' Australia/Sydney reject shift-forward)"
